# Sin comillas en los valores: Docker las lee tal cual (como parte
# del valor) en vez de quitarlas, a diferencia de los scripts normales
# de Node. Deja todos los valores de este archivo sin comillas.

DATABASE_URL=file:./dev.db

# Variables para crear el primer administrador con `npm run crear-admin`.
# No subas valores reales de estas variables a git.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Solo hace falta para el despliegue con Docker (docker-compose.yml y
# Caddyfile la usan). Es el dominio con el que entrarás a la app, p. ej.
# quedadapp.tudominio.com
DOMINIO=

# Claves para las notificaciones push (Web Push). Genera tu propio par
# con `npx web-push generate-vapid-keys` y pégalas aquí; no reutilices
# las de otro despliegue. VAPID_SUBJECT debe ser un mailto: o https:
# de contacto (lo exige el estándar, no se muestra a nadie).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
