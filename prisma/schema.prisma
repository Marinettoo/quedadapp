// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Rol {
  ADMIN
  USUARIO
}

enum EstadoCuenta {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Usuario {
  id                   String              @id @default(cuid())
  nombreUsuario        String              @unique
  email                String              @unique
  passwordHash         String
  rol                  Rol                 @default(USUARIO)
  estado               EstadoCuenta        @default(PENDIENTE)
  creadoEn             DateTime            @default(now())
  sesiones             Sesion[]
  partidosEncargados   Partido[]           @relation("PartidosEncargados")
  partidosCreados      Partido[]           @relation("PartidosCreados")
  asistencias          Asistencia[]
  valoracionesRecibidas Valoracion[]       @relation("ValoracionesRecibidas")
  valoracionesHechas   Valoracion[]        @relation("ValoracionesHechas")
  generacionesCreadas  GeneracionEquipos[]
  asignaciones         AsignacionEquipo[]
  pagos                Pago[]              @relation("PagosDelJugador")
  pagosConfirmados     Pago[]              @relation("PagosConfirmadosPor")
  enfrentamientos      Enfrentamiento[]
  invitadosAnadidos    Invitado[]
}

model Sesion {
  id          String   @id
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadaEn    DateTime @default(now())
  expiraEn    DateTime
}

model Partido {
  id            String             @id @default(cuid())
  fechaHora     DateTime
  ubicacion     String
  horasCierre   Int                @default(2)
  encargadoId   String
  encargado     Usuario            @relation("PartidosEncargados", fields: [encargadoId], references: [id])
  creadoPorId   String
  creadoPor     Usuario            @relation("PartidosCreados", fields: [creadoPorId], references: [id])
  creadoEn      DateTime           @default(now())
  asistencias   Asistencia[]
  generacion    GeneracionEquipos?
  importeTotal  Float?
  pagos         Pago[]
  enfrentamientos Enfrentamiento[]
  invitados     Invitado[]
  coloresEquipo ColorEquipo[]
}

model ColorEquipo {
  id        String  @id @default(cuid())
  partidoId String
  partido   Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  equipo    Int
  color     String

  @@unique([partidoId, equipo])
}

model Invitado {
  id           String             @id @default(cuid())
  partidoId    String
  partido      Partido            @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  nombre       String
  // valoración puesta directamente por quien lo añade, solo para este partido
  estrellas    Int
  anadidoPorId String
  anadidoPor   Usuario            @relation(fields: [anadidoPorId], references: [id])
  creadoEn     DateTime           @default(now())
  asignaciones AsignacionEquipo[]
  pagos        Pago[]
}

model Asistencia {
  id          String    @id @default(cuid())
  partidoId   String
  partido     Partido   @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  apuntadoEn  DateTime  @default(now())
  cancelado   Boolean   @default(false)
  canceladoEn DateTime?

  @@unique([partidoId, usuarioId])
}

model Valoracion {
  id            String   @id @default(cuid())
  valoradoId    String
  valorado      Usuario  @relation("ValoracionesRecibidas", fields: [valoradoId], references: [id], onDelete: Cascade)
  autorId       String
  autor         Usuario  @relation("ValoracionesHechas", fields: [autorId], references: [id], onDelete: Cascade)
  estrellas     Int
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([valoradoId, autorId])
}

enum Formato {
  TRIANGULAR
  DOS_EQUIPOS
}

model GeneracionEquipos {
  id            String             @id @default(cuid())
  partidoId     String             @unique
  partido       Partido            @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  formato       Formato
  generadoEn    DateTime           @default(now())
  generadoPorId String
  generadoPor   Usuario            @relation(fields: [generadoPorId], references: [id])
  asignaciones  AsignacionEquipo[]
}

model AsignacionEquipo {
  id           String            @id @default(cuid())
  generacionId String
  generacion   GeneracionEquipos @relation(fields: [generacionId], references: [id], onDelete: Cascade)
  // exactamente uno de los dos: jugador registrado o invitado
  usuarioId    String?
  usuario      Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  invitadoId   String?
  invitado     Invitado?         @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  // 0 = lista de espera; 1, 2 (y 3 en triangular) = número de equipo
  equipo       Int
}

model Enfrentamiento {
  id              String   @id @default(cuid())
  partidoId       String
  partido         Partido  @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  // número de equipo (1, 2 o 3) tal como quedó en la generación
  equipoLocal     Int
  equipoVisitante Int
  golesLocal      Int
  golesVisitante  Int
  registradoEn    DateTime @default(now())
  registradoPorId String
  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id])
  actualizadoEn   DateTime @updatedAt
}

model Pago {
  id              String    @id @default(cuid())
  partidoId       String
  partido         Partido   @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  // exactamente uno de los dos: jugador registrado o invitado
  usuarioId       String?
  usuario         Usuario?  @relation("PagosDelJugador", fields: [usuarioId], references: [id], onDelete: Cascade)
  invitadoId      String?
  invitado        Invitado? @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  indicadoEn      DateTime?
  confirmadoEn    DateTime?
  confirmadoPorId String?
  confirmadoPor   Usuario?  @relation("PagosConfirmadosPor", fields: [confirmadoPorId], references: [id])
  creadoEn        DateTime  @default(now())

  @@unique([partidoId, usuarioId])
  @@unique([partidoId, invitadoId])
}
