// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Rol {
  ADMIN
  USUARIO
}

enum EstadoCuenta {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum PiernaBuena {
  DIESTRO
  ZURDO
  AMBIDIESTRO
}

model Usuario {
  id                   String              @id @default(cuid())
  nombreUsuario        String              @unique
  email                String              @unique
  passwordHash         String
  rol                  Rol                 @default(USUARIO)
  estado               EstadoCuenta        @default(PENDIENTE)
  creadoEn             DateTime            @default(now())
  // null = sin foto de perfil; si no es null, hay un archivo guardado en
  // disco (fuera de la base de datos) y este campo sirve también para
  // forzar que el navegador recargue la imagen cuando cambia.
  fotoActualizadaEn    DateTime?
  // cómo se encuadra la foto en la tarjeta (arrastre + zoom desde "Mi
  // perfil"); desplazamiento en píxeles desde la posición por defecto
  // (abajo a la derecha) y escala (1 = tamaño normal).
  fotoOffsetX          Float               @default(0)
  fotoOffsetY          Float               @default(0)
  fotoEscala           Float               @default(1)
  // datos de jugador para la ficha; opcionales, los pone cada uno desde
  // "Mi perfil".
  fechaNacimiento      DateTime?
  piernaBuena          PiernaBuena?
  // true solo para quien ganó la última votación de MVP cerrada (uno
  // como mucho a la vez): pinta su ficha en negro y dorado hasta que se
  // cierre la siguiente votación de MVP.
  esMvpActual          Boolean             @default(false)
  sesiones             Sesion[]
  partidosEncargados   Partido[]           @relation("PartidosEncargados")
  partidosCreados      Partido[]           @relation("PartidosCreados")
  asistencias          Asistencia[]
  valoracionesRecibidas Valoracion[]       @relation("ValoracionesRecibidas")
  valoracionesHechas   Valoracion[]        @relation("ValoracionesHechas")
  generacionesCreadas  GeneracionEquipos[]
  asignaciones         AsignacionEquipo[]
  pagos                Pago[]              @relation("PagosDelJugador")
  pagosConfirmados     Pago[]              @relation("PagosConfirmadosPor")
  enfrentamientos      Enfrentamiento[]
  invitadosAnadidos    Invitado[]
  apuestasCreadas      Apuesta[]
  pronosticos          Pronostico[]        @relation("PronosticosDelJugador")
  aportesConfirmados   Pronostico[]        @relation("AportacionesConfirmadas")
  goles                GolJugador[]
  votacionesCreadas    VotacionFecha[]
  votosFecha           VotoFecha[]
  votacionesMvpCreadas VotacionMvp[]       @relation("VotacionMvpCreadaPor")
  mvpVotosRecibidos    VotoMvp[]           @relation("VotoMvpCandidato")
  mvpVotosEmitidos     VotoMvp[]           @relation("VotoMvpAutor")
  notificaciones       Notificacion[]
  suscripcionesPush    SuscripcionPush[]
  miembroGrupos        MiembroGrupo[]
  ajustesBoteCreados   AjusteBote[]
}

model Sesion {
  id          String   @id
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadaEn    DateTime @default(now())
  expiraEn    DateTime
}

model Partido {
  id            String             @id @default(cuid())
  fechaHora     DateTime
  ubicacion     String
  horasCierre   Int                @default(2)
  encargadoId   String
  encargado     Usuario            @relation("PartidosEncargados", fields: [encargadoId], references: [id])
  creadoPorId   String
  creadoPor     Usuario            @relation("PartidosCreados", fields: [creadoPorId], references: [id])
  creadoEn      DateTime           @default(now())
  asistencias   Asistencia[]
  generacion    GeneracionEquipos?
  importeTotal  Float?
  pagos         Pago[]
  enfrentamientos Enfrentamiento[]
  invitados     Invitado[]
  coloresEquipo ColorEquipo[]
  apuestas      Apuesta[]
  grupos        Grupo[]
  votacionesMvp VotacionMvp[]
}

// Grupo de jugadores que quieren coincidir en el mismo equipo al generar
// (p. ej. un grupo de amigos). Es cosa de cada partido, no permanente:
// lo crea el admin o el encargado antes de generar los equipos.
model Grupo {
  id        String         @id @default(cuid())
  partidoId String
  partido   Partido        @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  creadoEn  DateTime       @default(now())
  miembros  MiembroGrupo[]
}

model MiembroGrupo {
  id         String    @id @default(cuid())
  grupoId    String
  grupo      Grupo     @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  // exactamente uno de los dos: jugador registrado o invitado
  usuarioId  String?
  usuario    Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  invitadoId String?
  invitado   Invitado? @relation(fields: [invitadoId], references: [id], onDelete: Cascade)

  @@unique([grupoId, usuarioId])
  @@unique([grupoId, invitadoId])
}

// Apuesta fija sobre el resultado de un partido a 2 equipos: victoria de
// Equipo 1, empate o victoria de Equipo 2. Sin texto libre ni importe
// configurable: participar cuesta siempre 0.20 €, acierte o falle cada uno.
model Apuesta {
  id            String       @id @default(cuid())
  partidoId     String
  partido       Partido      @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  cuota         Float        @default(0.2)
  creadaPorId   String
  creadaPor     Usuario      @relation(fields: [creadaPorId], references: [id])
  resultado     String?
  resueltaEn    DateTime?
  creadaEn      DateTime     @default(now())
  pronosticos   Pronostico[]
}

model Pronostico {
  id        String  @id @default(cuid())
  apuestaId String
  apuesta   Apuesta @relation(fields: [apuestaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario @relation("PronosticosDelJugador", fields: [usuarioId], references: [id], onDelete: Cascade)
  respuesta String
  // cantidad que esta persona decide apostar, aparte de la cuota fija
  // de la apuesta (Apuesta.cuota).
  cantidad  Float
  creadoEn  DateTime @default(now())
  // null hasta que se resuelve la apuesta
  acierto               Boolean?
  // importe que debe aportar al bote: la cuota si acertó, cuota +
  // cantidad si falló (pierde lo apostado). Se fija al resolver.
  importeDebido         Float?
  // si acertó, lo que gana: la mitad de lo apostado (no el doble).
  // Se fija al resolver; no aplica si falló.
  importeGanado         Float?
  indicadoAporteEn      DateTime?
  confirmadoAporteEn    DateTime?
  confirmadoAportePorId String?
  confirmadoAportePor   Usuario?  @relation("AportacionesConfirmadas", fields: [confirmadoAportePorId], references: [id])

  @@unique([apuestaId, usuarioId])
}

model ColorEquipo {
  id        String  @id @default(cuid())
  partidoId String
  partido   Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  equipo    Int
  color     String

  @@unique([partidoId, equipo])
}

model Invitado {
  id           String             @id @default(cuid())
  partidoId    String
  partido      Partido            @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  nombre       String
  // valoración puesta directamente por quien lo añade, solo para este partido
  estrellas    Int
  esPortero    Boolean            @default(false)
  anadidoPorId String
  anadidoPor   Usuario            @relation(fields: [anadidoPorId], references: [id])
  creadoEn     DateTime           @default(now())
  asignaciones AsignacionEquipo[]
  pagos        Pago[]
  goles        GolJugador[]
  miembroGrupos MiembroGrupo[]
}

model Asistencia {
  id          String    @id @default(cuid())
  partidoId   String
  partido     Partido   @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  apuntadoEn  DateTime  @default(now())
  cancelado   Boolean   @default(false)
  canceladoEn DateTime?
  // si esta persona va a jugar de portero en ESTE partido; no es un
  // atributo fijo del jugador, se marca partido a partido
  esPortero   Boolean   @default(false)

  @@unique([partidoId, usuarioId])
}

model Valoracion {
  id            String   @id @default(cuid())
  valoradoId    String
  valorado      Usuario  @relation("ValoracionesRecibidas", fields: [valoradoId], references: [id], onDelete: Cascade)
  autorId       String
  autor         Usuario  @relation("ValoracionesHechas", fields: [autorId], references: [id], onDelete: Cascade)
  estrellas     Int
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([valoradoId, autorId])
}

enum Formato {
  TRIANGULAR
  DOS_EQUIPOS
}

model GeneracionEquipos {
  id            String             @id @default(cuid())
  partidoId     String             @unique
  partido       Partido            @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  formato       Formato
  generadoEn    DateTime           @default(now())
  generadoPorId String
  generadoPor   Usuario            @relation(fields: [generadoPorId], references: [id])
  asignaciones  AsignacionEquipo[]
}

model AsignacionEquipo {
  id           String            @id @default(cuid())
  generacionId String
  generacion   GeneracionEquipos @relation(fields: [generacionId], references: [id], onDelete: Cascade)
  // exactamente uno de los dos: jugador registrado o invitado
  usuarioId    String?
  usuario      Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  invitadoId   String?
  invitado     Invitado?         @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  // 0 = lista de espera; 1, 2 (y 3 en triangular) = número de equipo
  equipo       Int
  // copia de si jugaba de portero en el momento de generar, para no
  // depender de si luego cambia la marca en Asistencia/Invitado
  esPortero    Boolean           @default(false)
}

model Enfrentamiento {
  id              String   @id @default(cuid())
  partidoId       String
  partido         Partido  @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  // número de equipo (1, 2 o 3) tal como quedó en la generación
  equipoLocal     Int
  equipoVisitante Int
  golesLocal      Int
  golesVisitante  Int
  registradoEn    DateTime @default(now())
  registradoPorId String
  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id])
  actualizadoEn   DateTime @updatedAt
  goles           GolJugador[]
}

// Goles individuales anotados en un enfrentamiento concreto. Opcional: si no
// se rellena, el resultado del equipo cuenta igual pero no se atribuye a nadie.
model GolJugador {
  id               String         @id @default(cuid())
  enfrentamientoId String
  enfrentamiento   Enfrentamiento @relation(fields: [enfrentamientoId], references: [id], onDelete: Cascade)
  usuarioId        String?
  usuario          Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  invitadoId       String?
  invitado         Invitado?      @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  goles            Int

  @@unique([enfrentamientoId, usuarioId])
  @@unique([enfrentamientoId, invitadoId])
}

model Pago {
  id              String    @id @default(cuid())
  partidoId       String
  partido         Partido   @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  // exactamente uno de los dos: jugador registrado o invitado
  usuarioId       String?
  usuario         Usuario?  @relation("PagosDelJugador", fields: [usuarioId], references: [id], onDelete: Cascade)
  invitadoId      String?
  invitado        Invitado? @relation(fields: [invitadoId], references: [id], onDelete: Cascade)
  indicadoEn      DateTime?
  confirmadoEn    DateTime?
  confirmadoPorId String?
  confirmadoPor   Usuario?  @relation("PagosConfirmadosPor", fields: [confirmadoPorId], references: [id])
  creadoEn        DateTime  @default(now())

  @@unique([partidoId, usuarioId])
  @@unique([partidoId, invitadoId])
}

// Votación para decidir cuándo será el próximo partido (fecha y hora).
// No está ligada a un Partido: cuando se cierra y hay un ganador claro,
// el admin crea el partido a mano con esa fecha.
model VotacionFecha {
  id          String                @id @default(cuid())
  titulo      String
  creadaPorId String
  creadaPor   Usuario               @relation(fields: [creadaPorId], references: [id])
  creadaEn    DateTime              @default(now())
  cerrada     Boolean               @default(false)
  cerradaEn   DateTime?
  opciones    OpcionVotacionFecha[]
  votos       VotoFecha[]
}

model OpcionVotacionFecha {
  id         String        @id @default(cuid())
  votacionId String
  votacion   VotacionFecha @relation(fields: [votacionId], references: [id], onDelete: Cascade)
  fechaHora  DateTime
  votos      VotoFecha[]
}

model VotoFecha {
  id         String               @id @default(cuid())
  votacionId String
  votacion   VotacionFecha        @relation(fields: [votacionId], references: [id], onDelete: Cascade)
  opcionId   String
  opcion     OpcionVotacionFecha  @relation(fields: [opcionId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  votadoEn   DateTime             @default(now())

  @@unique([votacionId, usuarioId])
}

// Votación para elegir al MVP de un partido concreto: dura hasta que un
// admin la cierra (sin fecha límite), y al cerrarla se corona a quien
// tenga más votos (Usuario.esMvpActual) hasta la siguiente votación de
// MVP que se cierre. Si hay empate, cerrarVotacionMvp exige indicar a
// mano cuál de los empatados gana.
model VotacionMvp {
  id          String    @id @default(cuid())
  partidoId   String
  partido     Partido   @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  creadaPorId String
  creadaPor   Usuario   @relation("VotacionMvpCreadaPor", fields: [creadaPorId], references: [id])
  creadaEn    DateTime  @default(now())
  cerrada     Boolean   @default(false)
  cerradaEn   DateTime?
  // null si se cerró sin votos; si hubo empate, quien cerró la votación
  // tuvo que elegir uno de los empatados.
  ganadorId   String?
  votos       VotoMvp[]
}

model VotoMvp {
  id          String      @id @default(cuid())
  votacionId  String
  votacion    VotacionMvp @relation(fields: [votacionId], references: [id], onDelete: Cascade)
  candidatoId String
  candidato   Usuario     @relation("VotoMvpCandidato", fields: [candidatoId], references: [id], onDelete: Cascade)
  autorId     String
  autor       Usuario     @relation("VotoMvpAutor", fields: [autorId], references: [id], onDelete: Cascade)
  votadoEn    DateTime    @default(now())

  @@unique([votacionId, autorId])
}

// Avisos dentro de la app (campanita) para un jugador concreto: nuevos
// miembros que valorar, partidos, votaciones, resultados de apuestas...
model Notificacion {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String
  mensaje   String
  enlace    String?
  leidaEn   DateTime?
  creadaEn  DateTime  @default(now())

  @@index([usuarioId, leidaEn])
}

// Ajuste manual del bote hecho por un administrador: sumar o restar
// dinero a mano (fuera del flujo automático de apuestas falladas), por
// ejemplo para corregir un error o anotar un gasto o ingreso en efectivo.
model AjusteBote {
  id          String   @id @default(cuid())
  // positivo suma al bote, negativo resta
  importe     Float
  motivo      String
  creadoPorId String
  creadoPor   Usuario  @relation(fields: [creadoPorId], references: [id])
  creadoEn    DateTime @default(now())
}

// Suscripción del navegador/dispositivo de un usuario a notificaciones
// push (Web Push). Un usuario puede tener varias (varios dispositivos).
model SuscripcionPush {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  creadaEn  DateTime @default(now())
}
